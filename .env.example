# ============================================================================
# Family Board — environment template
# ----------------------------------------------------------------------------
# Copy to `.env` for local work and set the same names as encrypted env vars in
# the hosting provider for production. `.env` is gitignored; `.env.example`
# carries names and shapes only and must never hold a real value.
#
# THE RULE: the iPad never holds a Google credential. Anything below without a
# VITE_ prefix stays server-side. Vite inlines every VITE_-prefixed variable
# into the client bundle in plain text, so a secret with that prefix is a
# published secret.
#
# Owners: R1 declares the names. R4 implements auth and is the authority on
# these values. R8 (calendar) and R9 (drive) consume the minted tokens, never
# the secrets.
# ============================================================================


# ─── Google OAuth — R4. SERVER-SIDE ONLY. ───────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client ID, application type "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match a Authorized redirect URI on the client above, exactly.
# Local:      http://localhost:5173/api/auth/google
# Production: https://<your-board>.vercel.app/api/auth/google
GOOGLE_REDIRECT_URI=

# The long-lived refresh token minted once through the consent flow and stored
# server-side. This is the single most sensitive value in the project: it is
# what lets the board mint access tokens for months without a human. It must
# never appear in a response body, in localStorage, or in any payload that
# reaches the iPad.
GOOGLE_REFRESH_TOKEN=

# Space-separated scopes. Calendar read/write for R8's write-back; Drive
# read-only for R9's screensaver. Keep Drive read-only — the board has no
# reason to be able to delete photos.
GOOGLE_SCOPES="https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/drive.readonly"


# ─── Endpoint protection — R4 ───────────────────────────────────────────────
# The API sits on the public internet. Without a device check anyone who finds
# the URL can read the calendar. Long random string; the board sends it, the
# API requires it.
#   openssl rand -hex 32
BOARD_DEVICE_SECRET=

# The one origin allowed through CORS. No wildcard.
#   e.g. https://<your-board>.vercel.app
ALLOWED_ORIGIN=


# ─── Client-visible — safe to inline in the bundle ──────────────────────────
# Same value as BOARD_DEVICE_SECRET. It is unavoidably visible to anyone with
# the device or the bundle: it identifies the board, it does not authorise a
# Google account. That distinction is the whole point of the server-side token.
VITE_BOARD_DEVICE_SECRET=

# Base URL for the serverless API. Leave empty to use same-origin /api, which
# is correct for a Vercel deploy and for `vite dev` behind the proxy.
VITE_API_BASE_URL=


# ─── Drive screensaver — R9 ─────────────────────────────────────────────────
# Default Drive folder id for the photo screensaver. Also settable in Settings
# at runtime, which is the intended path; this is just a seed.
# From the folder URL: drive.google.com/drive/folders/<THIS>
DRIVE_FOLDER_ID=


# ─── Weather — R6 ───────────────────────────────────────────────────────────
# R6's mandate requires a KEYLESS provider (Open-Meteo or equivalent) so the
# board needs no extra secret and R6 is not blocked on R4. There is
# deliberately no API key here. Location is configured in Settings; these are
# only the first-run defaults.
VITE_WEATHER_DEFAULT_LAT=
VITE_WEATHER_DEFAULT_LON=
VITE_WEATHER_DEFAULT_LABEL=
